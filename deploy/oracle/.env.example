# Copied to .env by setup.sh (which fills SITE_HOST from the VM's public IP).
# The public IP 203.0.113.10 becomes 203-0-113-10.sslip.io.
SITE_HOST=203-0-113-10.sslip.io
# Optional. Empty: anyone with the link can use the site. Set: visitors type
# it once per browser session. Never commit a real code anywhere.
DEMO_ACCESS_CODE=
