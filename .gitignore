# Python environment and local tool binaries (rebuild with requirements.txt)
.venv/
/tools/
__pycache__/
*.pyc
.DS_Store

# Data: several GB, and data/ holds the company's own bid files (test-only, kept local).
# Only the locked test set's registry and documentation are versioned.
data/*
!data/test_holdout/

# Working area: scratch runs and data snapshots (tens of GB)
handoff/

# Reports, QA exports and run logs are local working material.
/reports/

# Local Claude Code state
.claude/

# Files uploaded through the UI (include company files)
ui/.inbox/
# Saved worksheets and remembered corrections of this machine
ui/.local/
# UI caches (full copies of data tables, include company rows)
ui/.cache/

# Internal handbook (mentions company projects; kept local)
docs/HANDBOOK_internal.md

# Deploy: built artefacts (the assembled package, the bundle cut from a working copy) and run records
deploy/space/
deploy/bundle/
deploy/tools/trace_production.json
deploy/tools/assemble_report.json
deploy/tools/scrub_parse_bidtabs.json
